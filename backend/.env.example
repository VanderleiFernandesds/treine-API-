# Conexao principal com o banco MySQL usado pelo backend.
DB_HOST=localhost
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_NAME=seu_banco

# Chave usada para assinar e validar os tokens JWT da autenticacao local.
JWT_SECRET=sua_chave_secreta_jwt

# Credenciais do Google OAuth para login social como segunda opcao.
GOOGLE_CLIENT_ID=seu_google_client_id
GOOGLE_CLIENT_SECRET=seu_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
